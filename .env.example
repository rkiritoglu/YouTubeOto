# ==============================================================================
# YouTube Otomasyon Botu - Çevre Değişkenleri ve API Anahtarları
# ==============================================================================
# Bu dosyayı kendi API anahtarlarınızla doldurun.

# 1. Google Gemini API Anahtarı (Senaryo, başlık, açıklama ve sahne promptları için)
# Almak için: https://aistudio.google.com/app/apikey (Ücretsizdir)
GEMINI_API_KEY=AIzaSy_BURAYA_GEMINI_API_ANAHTARINIZI_GIRIN

# 2. Pixabay API Anahtarı (Telifsiz Stok Videolar İçin - Tamamen Ücretsiz ve Anında Alınır)
# Almak için: https://pixabay.com/api/docs/ adresine gidin. Üye olup sayfadaki yeşil alandaki anahtarı kopyalayın.
PIXABAY_API_KEY=BURAYA_PIXABAY_API_ANAHTARINIZI_GIRIN

# 3. ElevenLabs API Anahtarı (Yapay Zeka Seslendirme İçin - İsteğe Bağlı)
# Almak için: https://elevenlabs.io/app/settings/api-keys
# NOT: Boş bırakırsanız sistem otomatik olarak tamamen ücretsiz Edge-TTS Türkçe sesine geçer!
ELEVENLABS_API_KEY=sk_BURAYA_ELEVENLABS_API_ANAHTARINIZI_GIRIN

# 4. YouTube OAuth İstemci Dosyası Adı (Google Cloud Console'dan indirilen JSON dosyası)
# İndirilen dosyayı proje klasörüne 'client_secret.json' olarak kaydedin.
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json

# (Opsiyonel Yedek) Pexels API Anahtarı:
PEXELS_API_KEY=
